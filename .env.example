PORT=8462
HOST=127.0.0.1
APP_ORIGIN=http://localhost:5173
DATA_DIR=./data
# Set to 1 only when an explicitly trusted reverse proxy strips client IP headers.
TRUST_PROXY=0
# Production sessions require HTTPS.
NODE_ENV=development
# Create a GitHub OAuth App; callback URL: https://ui.kreatix.dev/api/auth/github/callback
# Leave these unset to disable GitHub sign-in. Never put the secret in client code.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
